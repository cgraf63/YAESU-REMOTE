# YAESU-REMOTE Wi-Fi - copy to the boot drive of the SD card as wifi.txt
# Networks in order of preference (first = best). The box imports them
# at start and removes the passwords from this file.
# Raspberry Pi Zero 2 W: 2.4 GHz only.

ssid=MyHomeRouter
password=my-router-password

ssid=My iPhone
password=my-hotspot-password

# Wi-Fi country (regulatory domain)
country=CH
