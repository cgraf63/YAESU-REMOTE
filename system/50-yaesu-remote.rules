// /etc/polkit-1/rules.d/50-yaesu-remote.rules
//
// The YAESU-REMOTE server (user "yaesu") may, without sudo:
//   - manage Wi-Fi through NetworkManager (scan, add / change / delete
//     connections, activate)
//   - start the software update units yaesu-remote-update@check and
//     yaesu-remote-update@install (nothing else in systemd)

polkit.addRule(function (action, subject) {

    if (subject.user !== "yaesu") return polkit.Result.NOT_HANDLED;

    if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0) {
        return polkit.Result.YES;
    }

    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") === "start" &&
        (action.lookup("unit") === "yaesu-remote-update@check.service" ||
         action.lookup("unit") === "yaesu-remote-update@install.service")) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;

});
