// /etc/polkit-1/rules.d/50-yaesu-remote.rules
//
// The YAESU-REMOTE server (user "yaesu") may manage Wi-Fi through
// NetworkManager (scan, add / change / delete connections, activate)
// without sudo. Nothing else.

polkit.addRule(function (action, subject) {
    if (subject.user === "yaesu" && action.id.indexOf("org.freedesktop.NetworkManager.") === 0) {
        return polkit.Result.YES;
    }
});
